# Copy to .env.local (not committed) and fill in. Both values are public (RLS protects the data).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Clerk publishable key (public). Sign-in is Clerk's; without it the web build runs without accounts.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# PostHog (public project token; analytics stays off without it). Host: eu.i.posthog.com or us.i.posthog.com.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
