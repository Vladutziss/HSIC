{
  "name": "molted",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Molted monorepo: apps/app (aplicația), apps/web (landing molted.eu), packages/ui (design tokens comune).",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @molted/app",
    "dev:web": "npm run dev -w @molted/web",
    "build": "npm run build -w @molted/app",
    "build:web": "npm run build -w @molted/web",
    "build:artifact": "npm run build:artifact -w @molted/app",
    "test": "npm test -w @molted/app",
    "sync:functions": "node scripts/sync-functions.mjs"
  }
}
